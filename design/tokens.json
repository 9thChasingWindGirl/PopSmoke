      "successLight": "#DCFCE7",
      "error": "#EF4444",
      "errorLight": "#FEE2E2",
      "warning": "#EAB308",
      "warningLight": "#FEF9C3",
      "warningBorder": "#FDE047",
      "info": "#3B82F6",
      "infoLight": "#DBEAFE",
      "danger": "#FF4D4D",
      "amber": "#F59E0B"
    },
    "text": {
      "primary": "#000000",
      "secondary": "#374151",
      "muted": "#6B7280",
      "light": "#9CA3AF"
    },
    "glass": {
      "_note": "液态玻璃主题的语义色。ink 不是纯黑：玻璃面板上的纯黑会显得脏，压到 #16161A 才和磨砂质感合得上。",
      "canvas": "#DCDAE9",
      "tint": "#FFFFFF",
      "ink": "#16161A",
      "inkSecondary": "#4E4E5C",
      "inkMuted": "#8B8B99",
      "hairline": "#C9C9D4",
      "scrim": "#12121A"
    },
    "neutral": {
      "gray100": "#F3F4F6",
      "gray200": "#E5E7EB",
      "gray300": "#D1D5DB",
      "gray400": "#9CA3AF",
      "gray500": "#6B7280",
      "gray600": "#4B5563",
      "gray700": "#374151",
      "yellow200": "#FEF08A",
      "yellow300": "#FDE047",
      "red200": "#FECACA"
