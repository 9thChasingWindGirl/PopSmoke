{
  "$schema": "https://popsmoke.local/schema/tokens-v1.json",
  "meta": {
    "version": 1,
    "source": "styles/designSystem.ts + styles/componentStyles.ts + index.html",
    "note": "唯一真源。改动此文件后运行 `node tools/gen-tokens.mjs` 生成 Android/Kotlin 令牌，禁止在页面代码里写裸数值。"
  },
  "base": {
    "rem": 14,
    "remNote": "index.html: @media (max-width: 640px) { html { font-size: 14px } }，手机竖屏下 1rem = 14px。所有 rem 单位按此换算，才能与 Web 版在手机上等大。"
  },
  "color": {
    "core": {
      "black": "#000000",
      "white": "#FFFFFF",
      "paper": "#FDFBF7",
      "canvas": "#F0F0F0",
      "surfaceMuted": "#EEF2FF",
      "defaultAccent": "#F97316"
    },
    "theme": {
      "gold": "#FFD700",
      "coral": "#FF6B6B",
      "teal": "#4ECDC4",
      "lime": "#C7F464",
      "purple": "#A78BFA",
      "orange": "#FF9F43"
    },
    "status": {
      "success": "#22C55E",
      "successLight": "#DCFCE7",
      "error": "#EF4444",
      "errorLight": "#FEE2E2",
      "warning": "#EAB308",
      "warningLight": "#FEF9C3",
      "warningBorder": "#FDE047",
      "info": "#3B82F6",
      "infoLight": "#DBEAFE",
      "danger": "#FF4D4D",
      "amber": "#F59E0B"
    },
    "text": {
      "primary": "#000000",
      "secondary": "#374151",
      "muted": "#6B7280",
      "light": "#9CA3AF"
    },
    "neutral": {
      "gray100": "#F3F4F6",
      "gray200": "#E5E7EB",
      "gray300": "#D1D5DB",
      "gray400": "#9CA3AF",
      "gray500": "#6B7280",
      "gray600": "#4B5563",
      "gray700": "#374151",
      "yellow200": "#FEF08A",
      "yellow300": "#FDE047",
      "red200": "#FECACA"
    }
  },
  "presets": [
    {
      "id": "gold",
      "color": "#FFD700",
      "en": "Gold",
      "zh": "金色",
      "ja": "ゴールド",
      "ko": "골드"
    },
    {
      "id": "coral",
      "color": "#FF6B6B",
      "en": "Coral",
      "zh": "珊瑚红",
      "ja": "コーラル",
      "ko": "코랄"
    },
    {
      "id": "teal",
      "color": "#4ECDC4",
      "en": "Teal",
      "zh": "青绿",
      "ja": "ティール",
      "ko": "틸"
    },
    {
      "id": "lime",
      "color": "#C7F464",
      "en": "Lime",
      "zh": "浅绿",
      "ja": "ライム",
      "ko": "라임"
    },
    {
      "id": "purple",
      "color": "#A78BFA",
      "en": "Purple",
      "zh": "紫色",
      "ja": "パープル",
      "ko": "퍼플"
    },
    {
      "id": "orange",
      "color": "#FF9F43",
      "en": "Orange",
      "zh": "橙色",
      "ja": "オレンジ",
      "ko": "オレンジ"
    }
  ],
  "stroke": {
    "thin": 2,
    "default": 4,
    "thick": 6
  },
  "radius": {
    "none": 0,
    "sm": 2,
    "md": 16,
    "lg": 24,
    "full": 9999
  },
  "shadow": {
    "xs": 1,
    "pop": 4,
    "popHover": 2,
    "popLg": 8,
    "press": 2,
    "smoke": 7,
    "smokePressed": 3.5,
    "listItem": 2
  },
  "space": {
    "1": 0.25,
    "2": 0.5,
    "3": 0.75,
    "4": 1,
    "5": 1.25,
    "6": 1.5,
    "7": 1.75,
    "8": 2,
    "10": 2.5,
    "12": 3,
    "14": 3.5,
    "16": 4,
    "20": 5,
    "24": 6
  },
  "type": {
    "size": {
      "xs": 0.75,
      "sm": 0.875,
      "base": 1,
      "lg": 1.125,
      "xl": 1.25,
      "xxl": 1.5,
      "xxxl": 1.875,
      "xxxxl": 2.25,
      "fivexl": 3,
      "sixxl": 3.75,
      "gauge": 2.5
    },
  "weight": {
    "normal": 400,
    "bold": 700,
    "black": 900
  },
  "lineHeight": {
    "_note": "Tailwind 每档字号的默认行高（rem）。text-xs→1rem, text-sm→1.25rem, text-base→1.5rem, text-lg→1.75rem, text-xl→1.75rem, text-2xl→2rem, text-3xl→2.25rem, text-4xl→2.5rem, text-5xl/6xl→1em。gauge 是行内 2.5rem，继承 body 的 1.5。",
    "xs": 1,
    "sm": 1.25,
    "base": 1.5,
    "lg": 1.75,
    "xl": 1.75,
    "xxl": 2,
    "xxxl": 2.25,
    "xxxxl": 2.5,
    "fivexl": 3,
    "sixxl": 3.75,
    "gauge": 3.75
  },
    "tracking": {
      "tight": -0.025,
      "normal": 0,
      "wide": 0.025,
      "wider": 0.05,
      "widest": 0.1
    }
  },
  "icon": {
    "xs": 1.5,
    "sm": 1.5,
    "md": 2,
    "lg": 2
  },
  "layout": {
    "contentMaxRem": 32,
    "headerHeightPx": 60,
    "bottomBarHeightPx": 60,
    "dotGridSizePx": 20,
    "dotRadiusPx": 1,
    "smokeButtonMaxPx": 280,
    "buttonMinWidthPx": 80,
    "dialogMaxWidthRem": 24,
    "alertMaxRem": 28,
    "iconButtonRem": 3,
    "chipRem": 2,
    "themePanelWidthPx": 280,
    "menuMinWidthPx": 80,
    "timeWheelHeightPx": 128,
    "timeWheelRowPx": 40,
    "timeWheelColumnPx": 80,
    "svPanelHeightPx": 120,
    "hueBarHeightPx": 28
  },
  "motion": {
    "instant": 100,
    "press": 150,
    "fast": 150,
    "normal": 300,
    "slow": 500,
    "flip": 700,
    "gauge": 1000,
    "pulse": 2000,
    "bounce": 1000,
    "easing": {
      "smooth": [
        0.4,
        0,
        0.2,
        1
      ],
      "bounceEase": [
        0.68,
        -0.55,
        0.265,
        1.55
      ],
      "easeOutCurve": [
        0,
        0,
        0.58,
        1
      ],
      "linear": [
        0,
        0,
        1,
        1
      ]
    }
  }
}
