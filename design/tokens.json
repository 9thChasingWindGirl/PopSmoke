{
  "$schema": "https://popsmoke.local/schema/tokens-v1.json",
  "meta": {
    "version": 1,
    "source": "styles/designSystem.ts + styles/componentStyles.ts + index.html",
    "note": "唯一真源。改动此文件后运行 `node tools/gen-tokens.mjs` 生成 Android/Kotlin 令牌，禁止在页面代码里写裸数值。"
  },
  "base": {
    "rem": 14,
    "remNote": "index.html: @media (max-width: 640px) { html { font-size: 14px } }，手机竖屏下 1rem = 14px。所有 rem 单位按此换算，才能与 Web 版在手机上等大。"
  },
  "color": {
    "core": {
      "black": "#000000",
      "white": "#FFFFFF",
      "paper": "#FDFBF7",
      "canvas": "#F0F0F0",
      "surfaceMuted": "#EEF2FF",
      "defaultAccent": "#F97316"
    },
    "theme": {
      "gold": "#FFD700",
      "coral": "#FF6B6B",
      "teal": "#4ECDC4",
      "lime": "#C7F464",
      "purple": "#A78BFA",
      "orange": "#FF9F43"
