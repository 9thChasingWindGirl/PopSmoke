    },
    {
      "id": "teal",
      "color": "#4ECDC4",
      "en": "Teal",
      "zh": "青绿",
      "ja": "ティール",
      "ko": "틸"
    },
    {
      "id": "lime",
      "color": "#C7F464",
      "en": "Lime",
      "zh": "浅绿",
      "ja": "ライム",
      "ko": "라임"
    },
    {
      "id": "purple",
