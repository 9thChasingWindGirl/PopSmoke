    "size": {
      "xs": 0.75,
      "sm": 0.875,
      "base": 1,
      "lg": 1.125,
      "xl": 1.25,
      "xxl": 1.5,
      "xxxl": 1.875,
      "xxxxl": 2.25,
      "fivexl": 3,
      "sixxl": 3.75,
      "gauge": 2.5
    },
    "weight": {
      "normal": 400,
      "bold": 700,
      "black": 900
    },
    "lineHeight": {
      "_note": "Tailwind 每档字号的默认行高（rem）。text-xs→1rem, text-sm→1.25rem, text-base→1.5rem, text-lg→1.75rem, text-xl→1.75rem, text-2xl→2rem, text-3xl→2.25rem, text-4xl→2.5rem, text-5xl/6xl→1em。gauge 是行内 2.5rem，继承 body 的 1.5。",
      "xs": 1,
      "sm": 1.25,
      "base": 1.5,
      "lg": 1.75,
      "xl": 1.75,
      "xxl": 2,
      "xxxl": 2.25,
      "xxxxl": 2.5,
      "fivexl": 3,
      "sixxl": 3.75,
      "gauge": 3.75
    },
    "tracking": {
      "tight": -0.025,
      "normal": 0,
      "wide": 0.025,
      "wider": 0.05,
      "widest": 0.1
    }
  },
  "icon": {
    "xs": 1.5,
    "sm": 1.5,
    "md": 2,
    "lg": 2
  },
  "layout": {
    "contentMaxRem": 32,
    "headerHeightPx": 64,
    "bottomBarHeightPx": 60,
    "dotGridSizePx": 20,
    "dotRadiusPx": 1,
    "smokeButtonMaxPx": 280,
    "buttonMinWidthPx": 80,
    "dialogMaxWidthRem": 24,
    "alertMaxRem": 28,
    "iconButtonRem": 3,
    "chipRem": 2,
    "themePanelWidthPx": 280,
    "menuMinWidthPx": 80,
    "timeWheelHeightPx": 128,
    "timeWheelRowPx": 40,
    "timeWheelColumnPx": 80,
    "svPanelHeightPx": 120,
    "hueBarHeightPx": 28
  },
  "glass": {
    "_note": "液态玻璃主题参数。后缀即单位：*Alpha 为 0-1 透明度，*Px 为 dp，*Ms 为毫秒，其余为倍数。这些值决定整块玻璃的通透度与果冻手感，改这里就能整体调软/调硬。",
    "surfaceAlpha": 0.3,
    "surfaceStrongAlpha": 0.5,
    "surfaceDeepAlpha": 0.22,
    "_noteEdge": "边缘只有一根线，不是一个环。真实玻璃的边界是一根 1dp 的菲涅尔亮线：迎光侧（左上）最亮，背光侧（右下）几乎消失。这是整块面板上唯一允许被叫作「边框」的东西。",
    "edgeStrokePx": 1,
    "edgePeakAlpha": 0.6,
    "edgeMinAlpha": 0.03,
    "_noteRefract": "折射：只在边缘 refractBezelPx 宽的壁内位移，中心平板区一动不动。位移剖面是驼峰 —— 边界处为 0（壁厚为零、掠射不出光），壁腰处最大，进入平板回到 0。两端都连续，才不会留下同心接缝。",
    "refractBezelPx": 40,
    "refractDepthPx": 34,
    "refractPeak": 0.34,
    "_noteDisperse": "色散：R/G/B 三个通道按不同折射率分别取样，边缘强对比处才露一点彩边。不做彩色环 —— 那是「假色散」，一眼假。",
    "dispersionAmount": 0.3,
    "_noteSpecular": "左上那盏灯。半径是相对短边的比例，大了整块玻璃会泛白、通透感全无。",
    "specularAlpha": 0.16,
    "specularRadius": 0.13,
    "tintAlpha": 0.06,
    "fieldBandAlpha": 0.16,
    "fieldArcAlpha": 0.06,
    "_note3": "织纹：单向斜纹。它不是为了好看，是为了给折射提供参照物 —— 玻璃边缘把线段推开时错位肉眼可辨，弯曲一团柔光是看不出来的。",
    "weaveAlpha": 0.26,
    "weaveSpacingPx": 40,
    "weaveStrokePx": 1,
    "_noteShadow": "投影是一个与卡片同形的模糊块，只做垂直偏移。形状只要有一处不同形（上边少扩、下边多扩），读起来就是投影挪了位。",
    "shadowAlpha": 0.028,
    "shadowBlurPx": 16,
    "shadowLiftPx": 3,
    "shadowSpreadPx": 0,
    "radiusCardPx": 34,
    "radiusPanelPx": 28,
    "radiusFieldPx": 20,
    "radiusChipPx": 16,
    "radiusButtonPx": 26,
    "auroraBlobPx": 560,
    "auroraSecondaryPx": 420,
    "auroraAlpha": 0.78,
    "grainAlpha": 0.012,
    "driftDurationMs": 48000,
    "jellyPressScale": 0.945,
    "jellyPressSquash": 1.03,
    "jellyPressDamping": 0.42,
    "jellyPressStiffness": 780,
    "jellyReleaseDamping": 0.3,
    "jellyReleaseStiffness": 420,
    "weaveInkAlpha": 0.075,
    "solidSheenAlpha": 0.16,
    "_noteGlow": "内辉光：玻璃对背后明暗的唯一回应方式。绝不改填充浓度 —— 那等于给 div 换色。填充恒定中性，明暗补偿全部长在边缘：背景暗则辉光是白（玻璃把背后的光收进边缘），背景明则辉光是深墨（强光下玻璃的边界是一圈折射暗环）。中间调仍保留底强度，它是这块材质的身份特征（参考实现的「白内辉 40px」）。辉光带宽跟元件短边走，封顶短边 22%。",
    "glowBandPx": 12,
    "glowMaxAlpha": 0.45,
    "_noteGroup": "静默分组：内容区的底。轻量玻璃 —— 恒定中性填充 + 一层适度模糊的背景切片 + 内辉光，没有折射、没有投影。玻璃只留给浮动层，否则整页都在抢焦点。",
    "groupAlpha": 0.34,
    "dividerAlpha": 0.07,
    "_noteChrome": "顶栏是背景的模糊切片 + 一层极淡的白纱，底沿渐变到透明，不做硬边。",
    "chromeVeilAlpha": 0.06,
    "_noteNav": "底部浮岛。它必须明显比内容区的分组更透 —— 0.5 的时候读作一条白色塑料条，背后的色带全被压掉，只剩一圈灰雾。0.14 才让背景的光斑和织纹在岛里继续存在，材质感由边缘折射和那根菲涅尔线给，不由不透明度给。",
    "navAlpha": 0.62,
    "_noteControl": "高频交互控件（次要按钮、输入框、顶栏小圆片）的玻璃底。内容区的分组仍然是静默的，但这些是「要按的东西」，值得一层材质把它们从平面里抬起来。再高就变成通体玻璃了。",
    "controlAlpha": 0.3,
    "_noteOverlay": "浮层（弹窗、菜单）：比导航条更实，因为它要压住正在被阅读的内容。玻璃浮层太透就成了'看不清的一团雾'。",
    "overlayAlpha": 0.66
  },
